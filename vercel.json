{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/network", "schedule": "* * * * *" },
    { "path": "/api/cron/events", "schedule": "*/15 * * * *" }
  ]
}
