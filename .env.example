# Public origin used for social preview links.
SITE_URL=http://localhost:3000
# Run one Node process with a persistent writable disk.
DATABASE_PATH=./data/sidekick.sqlite
# Vercel requires a remote SQLite-compatible database; local files are development only.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_PURPOSE=production
# Protect the scheduled network and event discovery endpoints with a long random server-only secret.
CRON_SECRET=
# Set to 1 only with a separate DATABASE_PATH ending in .demo.sqlite.
SIDEKICK_DEMO=0
# Copy to .env.local and add your OpenAI key. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
# Event retrieval is server-only. Never use NEXT_PUBLIC_ for this key.
EXA_API_KEY=
# Global paid pipeline cap across all accounts; resets at midnight in SF. 0 pauses discovery.
DISCOVERY_DAILY_RUN_LIMIT=100
# Emergency switch: 1 disables every OpenAI and Exa call without changing keys.
SIDEKICK_AI_PAUSED=0
# Daily caps (reset at midnight in SF). 0 pauses that feature.
ONBOARDING_DAILY_LIMIT=3000
ONBOARDING_ACCOUNT_DAILY_LIMIT=150
VOICE_DAILY_LIMIT=500
VOICE_ACCOUNT_DAILY_LIMIT=40
SIGN_IN_EMAIL_DAILY_LIMIT=500

# Sign-in codes. Production refuses to issue codes until both are set; development shows the code inline.
RESEND_API_KEY=
AUTH_EMAIL_FROM="SF Sidekick <login@your-verified-domain.example>"

# Google web OAuth client. Enable Calendar API and register this exact redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/calendar/callback
# Generate once: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
# Keep this key stable; changing it requires users to reconnect their calendars.
TOKEN_ENCRYPTION_KEY=
